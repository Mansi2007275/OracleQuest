# ==============================================================================
# OracleQuest Environment Configuration
# Copy this file to .env.local and fill in your actual values:
# cp .env.local.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# Get these from: Supabase Dashboard -> Project Settings -> API
# URL: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
# Public Supabase project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key for client-side queries (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key with full admin privileges (Server-side ONLY, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI CONFIGURATION
# Get this from: Google AI Studio -> Get API Key
# URL: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
# Used for AI agent debate analysis, thesis generation, and autonomous resolution synthesis
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# SOMNIA NETWORK & WEB3 CONFIGURATION
# Somnia Testnet Docs: https://docs.somnia.network/
# ------------------------------------------------------------------------------
# Somnia Shannon Testnet RPC Endpoint (Default: https://dream-rpc.somnia.network)
NEXT_PUBLIC_SOMNIA_RPC_URL=https://dream-rpc.somnia.network

# Deployed OracleQuest prediction market smart contract address (0x...)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Somnia Shannon Testnet Chain ID: 50312 (or Somnia Devnet / Custom EVM Chain ID)
NEXT_PUBLIC_CHAIN_ID=50312

# Somnia Shannon Testnet Deployer Private Key (without or with 0x prefix)
PRIVATE_KEY=your-deployer-private-key-0x...

# Optional WalletConnect Cloud Project ID (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# ------------------------------------------------------------------------------
# MARKET DATA & EXTERNAL ORACLE APIS
# ------------------------------------------------------------------------------
# CoinGecko Demo or Pro API Key for live crypto asset price feeds and market metrics
# Get this from: CoinGecko Developer Dashboard
# URL: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=your-coingecko-api-key

# NewsAPI Key for real-time sentiment analysis, event discovery, and news feeds
# Get this from: NewsAPI Registration
# URL: https://newsapi.org/register
NEWS_API_KEY=your-news-api-key

